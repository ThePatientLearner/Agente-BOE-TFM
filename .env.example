# PLANTILLA PÚBLICA — este archivo SÍ se sube al repositorio.
# Nunca pongas aquí claves reales: cópialo a .env y rellénalo allí.
#   cp .env.example .env

# ── Base de datos (obligatoria: el monolito no arranca sin ella) ─
# Levántala con:  docker compose up -d db
# Las migraciones se aplican solas en el arranque.
DATABASE_URL=postgres://boe:boe@localhost:5432/boe_inspector

# ── IA (cualquier API compatible con el formato de OpenAI) ───────
# Cambiar de proveedor = cambiar estas tres variables, sin tocar código:
#   MiniMax  → https://api.minimax.io/v1        · MiniMax-M3
#   OpenAI   → https://api.openai.com/v1        · gpt-…
#   DeepSeek → https://api.deepseek.com/v1      · deepseek-chat
#   Ollama   → http://localhost:11434/v1        · llama3.1  (local, sin coste)
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=MiniMax-M3
AI_API_KEY=

# Impacto mínimo (1-5) para publicar en los canales. Por debajo, la
# disposición sale en la web pero no se notifica. 1 = notificarlo todo.
NOTIFY_MIN_IMPACT=3

# ── Notificadores (opcionales: sin token, el canal se desactiva) ─
TELEGRAM_BOT_TOKEN=
# Canal PÚBLICO: solo resúmenes del BOE para suscriptores.
TELEGRAM_CHANNEL=@boe_inspector
# Chat PRIVADO (tu user id numérico): solo alertas de operación
# (ingesta fallida, parser, etc.). NUNCA el @ del canal.
# Cómo obtenerlo: escribe /start al bot y mira getUpdates, o usa @userinfobot.
TELEGRAM_ALERT_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Programación ─────────────────────────────────────────────────
# Revisión cada mañana a las 08:30 Europe/Madrid, los 7 días.
# (El BOE suele publicar L-S ~07:30; si no hay sumario, la ingesta es no-op.)
CRON_SCHEDULE="30 8 * * *"
# Reintentos del mismo día, separados por comas. Existen porque el sumario no
# siempre está publicado a las 08:30 y porque la IA o un canal pueden estar
# caídos justo entonces. Cada reintento reejecuta la ingesta (idempotente: si
# el día ya está entero no toca la IA) y reanuda lo que quedó a medias.
# Dejar vacío para desactivarlos.
CRON_RETRY_SCHEDULES="0 10 * * *,0 12 * * *"
# Días naturales anteriores al de hoy que cada pasada reintenta por si el
# boletín de ayer llegó tarde o el proceso estuvo caído. 1 es el valor
# recomendado (idempotente: si ayer ya está bien solo cuesta una petición).
# 0 desactiva el lookback. Máximo 7.
CRON_LOOKBACK_DAYS=1
TZ=Europe/Madrid

# ── Servicio ─────────────────────────────────────────────────────
API_PORT=3001
# Dominio público de la web: se usa para componer los enlaces "resumen
# completo" de las notificaciones. En producción NUNCA localhost.
PUBLIC_WEB_URL=https://agenteboe.com
BOE_SECTIONS=1

# Segunda pasada: la IA revisa su propio resumen contra el texto oficial.
# Duplica el coste (céntimos) y corrige idioma, fidelidad y precisión.
AI_REVIEW=true

# Contraseña de la "Búsqueda completa" en la web (archivo entero, no solo
# los 15 últimos boletines). Sin ella el botón de la portada solo sirve
# para contactar contigo; el endpoint /api/search responde 503.
# FULL_SEARCH_PASSWORD=

# Hash scrypt del código de invitación a Electricidad (solo servidor).
# Sin configurarlo, el registro permanece cerrado. Nunca introducirlo en la web.
ELECTRICIDAD_REGISTRATION_CODE_HASH=
# Hash scrypt de la contraseña de registro del BoeBot (solo servidor).
# Sin configurarlo, no se pueden crear cuentas nuevas. No publicar su valor.
BOT_REGISTRATION_CODE_HASH=
# Bot conversacional de la portada: independiente del proveedor de resúmenes.
# Modelo fijo gpt-6-luna, razonamiento high. Sin clave, responde 503.
BOT_OPENAI_API_KEY=

# ── Bot público: qué modelo responde ──────────────────────────────────
# El administrador puede cambiarlo en caliente desde el panel del bot
# (abajo a la derecha, con sesión de admin). Esto es solo el de partida.
#   gpt      → BOT_OPENAI_API_KEY
#   minimax  → BOT_MINIMAX_API_KEY
#
# ⚠️ Si lo cambias, cambia también /privacidad: la web nombra a quién se envían
# las preguntas del asistente, y esa lista es una obligación legal.
BOT_MODEL=minimax

# ►► EL TOKEN DE MINIMAX M3 VA AQUÍ ◄◄
# Es una clave DISTINTA de AI_API_KEY: esa es la de los resúmenes del BOE, y
# separarlas evita que una fuga o un agotamiento de cuota del bot público
# tumbe la ingesta diaria. Sin clave, MiniMax no aparece en el selector.
BOT_MINIMAX_API_KEY=
BOT_MINIMAX_BASE_URL=https://api.minimax.io/v1
BOT_MINIMAX_MODEL=MiniMax-M3

# Repasos que el bot da a su propia respuesta antes de entregarla.
# Cada repaso es una llamada más: mejor respuesta, más coste y más espera.
# 0 = contesta a la primera. Si no caben en el plazo, sale el borrador.
BOT_REVIEW_PASSES=2
# Límite global diario de tokens (entrada + salida + razonamiento).
# Reservas conservadoras antes de llamar a OpenAI; ajuste con consumo real.
BOT_DAILY_TOKENS=200000
# Enlace opcional de contacto del BoeBot (también en Vercel).
# Por defecto abre https://t.me/FinanFocus. Usar https://t.me/USUARIO para cambiarlo.
BOT_TELEGRAM_CONTACT_URL=
