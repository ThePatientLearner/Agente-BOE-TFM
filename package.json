{
  "name": "boe-inspector",
  "private": true,
  "version": "0.1.0",
  "description": "Resúmenes diarios del BOE (Sección I) con IA: web + Telegram + Discord. Servicio gratuito e independiente, no vinculado al BOE.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "demo": "node scripts/tfm-demo.mjs",
    "demo:tfm": "node scripts/tfm-demo.mjs",
    "demo:api": "node scripts/tfm-demo.mjs api",
    "demo:web": "node scripts/tfm-demo.mjs web",
    "dev": "npm run dev --workspace @boe-inspector/monolith",
    "dev:web": "npm run dev --workspace @boe-inspector/web",
    "probe": "npm run probe --workspace @boe-inspector/monolith",
    "ingest": "npm run ingest --workspace @boe-inspector/monolith",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "npm run check:boundaries --workspace @boe-inspector/monolith",
    "notify:test": "npm run notify:test --workspace @boe-inspector/monolith",
    "resummarize": "npm run resummarize --workspace @boe-inspector/monolith --",
    "report": "npm run report --workspace @boe-inspector/monolith --",
    "subvenciones:ingest": "npm run subvenciones:ingest --workspace @boe-inspector/monolith --",
    "subvenciones:directas": "npm run subvenciones:directas --workspace @boe-inspector/monolith --",
    "subvenciones:notify": "npm run subvenciones:notify --workspace @boe-inspector/monolith --"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28",
      "sharp": "0.35.5"
    },
    "node-cron": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
